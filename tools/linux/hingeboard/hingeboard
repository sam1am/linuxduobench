BAR = [("", "lclick"), ("", "rclick"), ("", "mic"), ("", "toggle"), ("Exit", "exit")]   # Enter: the key on the keyboard
# enter beside the mic: say it, then send it (2026-11-06)
# left + right mouse buttons (held while the finger is down: hold left + drag on the trackpad = select / move),
# mic = voice to text (moved up from the bottom row), mode switch, phone (2026-11-06)   # one Keys<->Gamepad switch (2026-11-06); Desktop dropped 2026-11-06 (its live
                                                                    # rotation crashed phosh) -> one-display mode instead
ACTIVE_FLAG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hingeboard-active")
SCREENS_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hingeboard-screens")   # mirror | tv
NOTOUCH_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hingeboard-notouch")   # 1 = touchpad off
IN_DESKTOP = os.environ.get("HINGEBOARD_SESSION") == "desktop"   # running inside the labwc desktop session (laptop mode)

def rrect(cr, x0, y0, w, h, r):
    """a rounded-rectangle path"""
    cr.new_sub_path()
    cr.arc(x0 + w - r, y0 + r, r, -math.pi / 2, 0); cr.arc(x0 + w - r, y0 + h - r, r, 0, math.pi / 2)
    cr.arc(x0 + r, y0 + h - r, r, math.pi / 2, math.pi); cr.arc(x0 + r, y0 + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()

kbd = UInput({E.EV_KEY: [c for row in KEYS for (_, c, _) in row if isinstance(c, int)]}, name="Hingeboard")
