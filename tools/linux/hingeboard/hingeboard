PAD_COLORS = {K.BTN_SOUTH: (0.30, 0.68, 0.30), K.BTN_EAST: (0.82, 0.26, 0.24),     # A green, B red,
              K.BTN_WEST: (0.22, 0.48, 0.86), K.BTN_NORTH: (0.90, 0.72, 0.15)}     # X blue, Y yellow
