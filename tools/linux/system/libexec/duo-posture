#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
"""duo-posture: the Surface Duo's two-screen layout on Plasma (KWin), driven by its sensors.

Runs in the desktop session (systemd user unit duo-posture.service) as the desktop user. Inputs:
  - hinge angle: `duo-ssc-read hinge_angle` (Microsoft's SSC sensor: 0 closed, 180 flat, ~355 folded back to back)
  - orientation + tilt: `monitor-sensor --accel` (iio-sensor-proxy with libssc)
  - touches: the two iptsd virtual touchscreens (0C02 = left = DSI-1, 0C01 = right = DSI-2), read-only
Outputs: `kscreen-doctor` (rotation, position, enable/disable) and KWin's InputDevice D-Bus "enabled" property.

  - Both screens open: rotate both together; landscape stacks them (the screen on the upper edge on top), upside down
    swaps them; the hinge gap is kept. The rotation lock (Plasma's quick setting = KWin's auto-rotate policy
    "Never") is respected.
  - Folded back (hinge >= FOLD_ON): the screen facing away is switched off and its touchscreen ignored, so the hand on
    the back does nothing. Which screen faces away comes from the tilt of the accelerometer's half: the first time,
    the first touch while folded says which screen is in front, and that is remembered (STATE file); after that the
    tilt alone decides, and turning the folded phone over swaps the screens. Unfolding (hinge <= FOLD_OFF) restores
    both.
Nothing here writes to the phone's storage except the small state file in the user's home.
"""
import json, os, re, select, signal, struct, subprocess, sys, time

FOLD_ON, FOLD_OFF = 330.0, 310.0     # degrees, with hysteresis
GAP = 33                             # logical px between the panels (the hinge), as org.duo.HingeGap.desktop
SCALE_W, SCALE_H = 1350, 1800        # native portrait mode
TOUCH = {"045E:0C02": "DSI-1", "045E:0C01": "DSI-2"}   # iptsd virtual touchscreen -> output
LEFT, RIGHT = "DSI-1", "DSI-2"
STATE = os.path.expanduser("~/.local/state/duo-posture.json")
KWINOUT = os.path.expanduser("~/.config/kwinoutputconfig.json")
ROT = {"normal": "none", "bottom-up": "inverted", "left-up": "left", "right-up": "right"}
EV = struct.Struct("llHHi")          # struct input_event on 64-bit
EV_SYN, EV_KEY, EV_ABS, BTN_TOUCH, ABS_X, ABS_Y = 0, 1, 3, 0x14a, 0, 1
# iptsd's virtual touchscreens report the raw digitizer axes; udev gives libinput the matrix 0 -1 1 / -1 0 1, i.e.
# on the screen (portrait, normal):  x = 1 - rawY/maxY,  y = 1 - rawX/maxX   (0..1, origin top left)
RAW_MAX_X, RAW_MAX_Y = 9600, 7200
# swipe along the top towards the hinge = move that screen's app to the other screen (both screens open, portrait)
SWIPE_TOP, SWIPE_END_TOP, SWIPE_DX, SWIPE_MAX_S = 0.05, 0.20, 0.40, 2.0


def log(*a):
    print("duo-posture:", *a, flush=True)


def other(o):
    return RIGHT if o == LEFT else LEFT


class Posture:
    def __init__(self):
        self.angle = None
        self.orient = "normal"
        self.tilt = 0                # +1 accelerometer half faces up, -1 down, 0 vertical/unknown
        self.tilt_since = 0.0
        self.folded = False
        self.front = None            # output kept on while folded
        self.applied = None
        self.faceup, self.last_front = self.load()  # learned: front when folded + tilt +1; last front used
        self.held = {LEFT: False, RIGHT: False}     # a finger is on that screen right now
        self.picked_by, self.decided_tilt = None, 0
        self.scale = 2.55

    # ---------- state ----------
    def load(self):
        try:
            with open(STATE) as f:
                d = json.load(f)
            ok = lambda v: v if v in (LEFT, RIGHT) else None
            return ok(d.get("faceup_output")), ok(d.get("last_front"))
        except (OSError, ValueError, AttributeError):
            return None, None

    def save(self):
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump({"faceup_output": self.faceup, "last_front": self.last_front}, f)
        os.replace(STATE + ".tmp", STATE)

    def locked(self):
        """Plasma's rotation quick setting off = KWin auto-rotate policy Never on the outputs."""
        try:
            with open(KWINOUT) as f:
                for sec in json.load(f):
                    if sec.get("name") == "outputs":
                        return any(o.get("autoRotation") == "Never" for o in sec["data"])
        except (OSError, ValueError, KeyError, TypeError):
            pass
        return False

    # ---------- layout ----------
    def layout(self):
        rot = self.orient if not self.locked() else (self.applied[0] if self.applied else "normal")
        w = -(-SCALE_W * 100 // round(self.scale * 100))   # logical width, rounded up as KWin does (530)
        if self.folded and self.front:
            return (rot, {self.front: (0, 0), other(self.front): None})
        if rot == "normal":      pos = {LEFT: (0, 0), RIGHT: (w + GAP, 0)}
        elif rot == "bottom-up": pos = {RIGHT: (0, 0), LEFT: (w + GAP, 0)}
        elif rot == "left-up":   pos = {LEFT: (0, 0), RIGHT: (0, w + GAP)}
        else:                    pos = {RIGHT: (0, 0), LEFT: (0, w + GAP)}
        return (rot, pos)

    def apply(self, force=False):
        want = self.layout()
        if want == self.applied and not force:
            return
        rot, pos = want
        args = ["kscreen-doctor"]
        for o in (LEFT, RIGHT):          # enable first, then disable: never zero outputs at once
            if pos[o] is not None:
                args += [f"output.{o}.enable", f"output.{o}.rotation.{ROT[rot]}", f"output.{o}.position.{pos[o][0]},{pos[o][1]}"]
        for o in (LEFT, RIGHT):
            if pos[o] is None:
                args += [f"output.{o}.disable"]
        r = subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=10)
        if r.returncode:
            log("kscreen-doctor failed:", r.stderr.strip()[:200])
            return
        for o in (LEFT, RIGHT):
            self.touch_enable(o, pos[o] is not None)
        self.applied = want
        log("layout", rot, {o: p for o, p in pos.items()}, "angle", self.angle)

    def touch_enable(self, out, on):
        for dev, o in self.touchdevs.items():
            if o == out:
                subprocess.run(["busctl", "--user", "set-property", "org.kde.KWin", f"/org/kde/KWin/InputDevice/{dev}",
                                "org.kde.KWin.InputDevice", "enabled", "b", "true" if on else "false"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)

    # ---------- decisions ----------
    def on_angle(self, a):
        self.angle = a
        if not self.folded and a >= FOLD_ON:
            self.folded = True
            self.front = None
            log(f"folded back ({a:.0f} deg)")
            self.decide()
        elif self.folded and a <= FOLD_OFF:
            self.folded = False
            self.front = None
            log(f"unfolded ({a:.0f} deg)")
            self.apply()

    def decide(self, touched=None):
        """Folded: pick the front screen. In order: a finger held on exactly one screen while folding (or the first
        touch afterwards), the learned tilt mapping, the screen used last time. A screen picked by touch also teaches
        the tilt mapping."""
        if not self.folded or self.front is not None:
            return
        held = [o for o, h in self.held.items() if h]
        pick, why = None, None
        if touched:
            pick, why = touched, "touch"
        elif len(held) == 1:
            pick, why = held[0], "held"
        elif self.faceup and self.tilt:
            pick, why = (self.faceup if self.tilt > 0 else other(self.faceup)), "tilt"
        elif self.last_front:
            pick, why = self.last_front, "last used"
        if not pick:
            log("folded: no finger, no tilt, nothing learned - both screens stay on until a touch")
            return
        self.front, self.picked_by, self.decided_tilt = pick, why, self.tilt
        if why in ("touch", "held") and self.tilt:
            self.learn()
        self.last_front = pick
        self.save()
        log(f"front screen {pick} ({why}; tilt {self.tilt})")
        self.apply()

    def learn(self):
        self.faceup = self.front if self.tilt > 0 else other(self.front)
        log("learned: folded + face up ->", self.faceup)

    def on_tilt(self, t):
        sign = {"face-up": 1, "tilted-up": 1, "face-down": -1, "tilted-down": -1}.get(t, 0)
        if sign != self.tilt:
            self.tilt, self.tilt_since = sign, time.monotonic()

    def tick(self):
        if not self.folded:
            return
        if self.front is None:
            if self.faceup and self.tilt:
                self.decide()
            return
        if not self.tilt or time.monotonic() - self.tilt_since < 0.7:
            return
        if not self.decided_tilt:
            # decided while vertical: this tilt belongs to the chosen screen (learn it if a finger chose it)
            self.decided_tilt = self.tilt
            if self.picked_by in ("touch", "held"):
                self.learn(); self.save()
        elif self.tilt == -self.decided_tilt:
            # turned over (stable 0.7 s): the other screen is in front now
            self.front = other(self.front); self.decided_tilt = self.tilt
            self.last_front = self.front; self.save()
            log("turned over ->", self.front)
            self.apply()

    def on_stroke(self, out, start, end, secs):
        """A finger lifted. A swipe along the top of a screen towards the hinge sends that screen's app across."""
        if self.folded or not self.applied or self.applied[0] != "normal" or None in self.applied[1].values():
            return                                   # only with both screens open in portrait
        sx, sy, _ = start; ex, ey = end
        dx = ex - sx if out == LEFT else sx - ex     # towards the hinge: right on the left screen, left on the right
        if sy <= SWIPE_TOP and ey <= SWIPE_END_TOP and dx >= SWIPE_DX and secs <= SWIPE_MAX_S:
            log(f"top swipe on {out} towards the hinge ({dx:.2f}) -> move its app across")
            subprocess.run(["busctl", "--user", "call", "org.kde.kglobalaccel", "/component/kwin",
                            "org.kde.kglobalaccel.Component", "invokeShortcut", "s", f"DuoMoveFrom{out}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)

    def on_orient(self, o):
        if o in ROT:
            self.orient = o
            self.apply()

    # ---------- inputs ----------
    def find_touch(self):
        devs = {}
        for e in os.listdir("/sys/class/input"):
            if not e.startswith("event"):
                continue
            try:
                with open(f"/sys/class/input/{e}/device/name") as f:
                    n = f.read().strip()
            except OSError:
                continue
            for k, o in TOUCH.items():
                if n == f"IPTSD Virtual Touchscreen {k}":
                    devs[e] = o
        return devs


def screen_xy(st):
    """raw digitizer position -> (x, y) on the screen in portrait, 0..1 (see RAW_MAX_X)"""
    return 1 - st["y"] / RAW_MAX_Y, 1 - st["x"] / RAW_MAX_X


def spawn(cmd):
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)


def main():
    p = Posture()
    p.touchdevs = p.find_touch()

    def restore(*_):
        # never leave a screen switched off behind us
        p.folded = False; p.front = None
        try:
            p.apply(force=True)
        finally:
            sys.exit(0)
    signal.signal(signal.SIGTERM, restore)
    signal.signal(signal.SIGINT, restore)
    log("touchscreens", p.touchdevs, "learned faceup", p.faceup)
    hinge = mon = None
    touchfd, tstate = {}, {}
    next_spawn = 0.0
    p.apply(force=True)
    while True:
        now = time.monotonic()
        if now >= next_spawn:
            if hinge is None or hinge.poll() is not None:
                hinge = spawn(["duo-ssc-read", "hinge_angle"])
            if mon is None or mon.poll() is not None:
                mon = spawn(["stdbuf", "-oL", "monitor-sensor", "--accel"])   # line-buffered through the pipe
            if len(touchfd) < 2:
                p.touchdevs = p.find_touch()
                for dev, o in p.touchdevs.items():
                    if o not in touchfd.values():
                        try:
                            touchfd[os.open(f"/dev/input/{dev}", os.O_RDONLY | os.O_NONBLOCK)] = o
                        except OSError:
                            pass
            next_spawn = now + 5
        fds = [hinge.stdout, mon.stdout] + list(touchfd)
        r, _, _ = select.select(fds, [], [], 0.3)
        for f in r:
            if f is hinge.stdout:
                line = f.readline()
                if not line:
                    hinge.wait(); continue
                v = line.split()
                if len(v) >= 2 and v[0] == "hinge_angle":
                    p.on_angle(float(v[1]))
            elif f is mon.stdout:
                line = f.readline()
                if not line:
                    mon.wait(); continue
                m = re.search(r"orientation(?: changed)?: ([a-z-]+)", line)
                if m:
                    p.on_orient(m.group(1))
                m = re.search(r"[Tt]ilt(?: changed)?: ([a-z-]+)", line)
                if m:
                    p.on_tilt(m.group(1))
            else:
                try:
                    data = os.read(f, EV.size * 64)
                except OSError:
                    os.close(f); p.held[touchfd[f]] = False; del touchfd[f]; tstate.pop(f, None); continue
                st = tstate.setdefault(f, {"down": False, "x": 0, "y": 0, "start": None})
                out = touchfd[f]
                for i in range(0, len(data) - EV.size + 1, EV.size):
                    _, _, typ, code, val = EV.unpack_from(data, i)
                    if typ == EV_ABS and code == ABS_X:
                        st["x"] = val
                    elif typ == EV_ABS and code == ABS_Y:
                        st["y"] = val
                    elif typ == EV_KEY and code == BTN_TOUCH:
                        st["down"] = bool(val); p.held[out] = bool(val)
                        if val:
                            st["start"] = None          # set at the end of this frame (the position follows)
                            if p.folded and p.front is None:
                                p.decide(touched=out)
                        elif st["start"]:
                            p.on_stroke(out, st["start"], screen_xy(st), time.monotonic() - st["start"][2])
                    elif typ == EV_SYN and st["down"] and st["start"] is None:
                        x, y = screen_xy(st)
                        st["start"] = (x, y, time.monotonic())
        p.tick()


if __name__ == "__main__":
    main()
