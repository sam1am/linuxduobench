#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Surface Duo: the sensor DSP (SLPI) across a suspend. A systemd-sleep hook (/usr/lib/systemd/system-sleep/duo-sensors,
# called with pre|post <type>); by hand: duo-sensors-resume now (= the post-resume recovery).
# Found 2026-11-12 (first s2idle on this kernel): during s2idle every user process is frozen, including hexagonrpcd,
# which serves the SLPI's file requests (sensor registry writes, all the time); with no answer for ~16 s its
# sensor_process takes a fatal error ("err_qdi.c ... sensor_process ... frpc_dsp") and, recovery being off
# (duo-sensors), the hinge / accelerometer / light sensors are gone until a reboot.
#  pre : stop duo-sensors = stop hexagonrpcd only (the SLPI keeps running without it, just without file access -
#        docs/drivers/sensors.md; Debian's own hexagonrpcd-suspend/-resume units do the same on SDM670)
#  post: if the SLPI crashed anyway: one recovery; then start duo-sensors again (+ iio-sensor-proxy after a crash).
#        In the background, so resume is not held up. duo-lid and duo-sway-posture re-open their hinge readers themselves.
slpi() { for r in /sys/class/remoteproc/remoteproc*; do [ "$(cat $r/name 2>/dev/null)" = slpi ] && echo $r; done; }
post() {
	R=$(slpi); crashed=0
	if [ -n "$R" ]; then
		for i in 1 2 3 4 5 6; do [ "$(cat $R/state)" = crashed ] && break; sleep 0.5; done   # it shows just after resume
		if [ "$(cat $R/state)" = crashed ]; then
			crashed=1
			echo "duo-sensors-resume: SLPI crashed during suspend, recovering" > /dev/kmsg
			systemctl stop duo-sensors
			echo recover > $R/recovery
			for i in $(seq 1 20); do [ "$(cat $R/state)" = running ] && break; sleep 0.5; done
		fi
	fi
	systemctl start duo-sensors
	if [ $crashed = 1 ]; then
		systemctl restart iio-sensor-proxy
		# hinge readers opened before the SLPI restart stay connected but never get another reading (the posture daemon
		# then kept "180 deg" with the phone closed): end them, duo-lid and duo-sway-posture start new ones
		pkill -x duo-ssc-read
	fi
	echo "duo-sensors-resume: SLPI $(cat $R/state 2>/dev/null), sensors up (crash: $crashed)" > /dev/kmsg
}
# The Bluetooth UART (c8c000.serial) is a wakeup source and the WCN3998 chatters on it: every sleep ended after
# 0.5-1 s (2026-11-04 on pmOS, again 2026-11-12 here). Off for the sleep, back on after (Bluetooth works when awake).
BTW=/sys/bus/platform/devices/c8c000.serial/power/wakeup
WS=/sys/kernel/debug/wakeup_sources; SNAP=/run/duo-wakeup-sources
snap() { [ -r $WS ] && awk 'NR>1 {print $1, $3}' $WS > $1; }
woke_by() {   # the wakeup sources whose event count went up during the sleep
	[ -r $WS ] && [ -f $SNAP ] || return
	snap $SNAP.after
	w=$(awk 'NR==FNR {a[$1]=$2; next} ($1 in a) && $2 > a[$1] {printf "%s ", $1}' $SNAP $SNAP.after)
	echo "duo-sensors-resume: woken by: ${w:-?}" > /dev/kmsg
	rm -f $SNAP $SNAP.after
}
case "$1" in
pre)
	mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
	snap $SNAP
	[ -w $BTW ] && echo disabled > $BTW
	systemctl stop duo-sensors ;;
post)
	woke_by
	[ -w $BTW ] && echo enabled > $BTW
	(post > /dev/null 2>&1 &) ;;
now) post ;;
esac
exit 0
