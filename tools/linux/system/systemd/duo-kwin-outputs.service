# Surface Duo: both panels' brightness by backlight only (no KWin software dimming on one of them) - duo-kwin-outputs
[Unit]
Description=Surface Duo: KWin brightness by backlight on both panels
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/duo/duo-kwin-outputs

[Install]
WantedBy=multi-user.target
