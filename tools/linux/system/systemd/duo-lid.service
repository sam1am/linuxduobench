# Surface Duo: the hinge as a laptop lid switch (duo-lid); the desktop (sway) turns the screens off when it closes
[Unit]
Description=Surface Duo hinge as a laptop lid (screens off / sleep when closed)
After=duo-sensors.service
Wants=duo-sensors.service
Before=upower.service display-manager.service

[Service]
ExecStart=/usr/libexec/duo/duo-lid
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
