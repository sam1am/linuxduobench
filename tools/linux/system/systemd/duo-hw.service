# Surface Duo hardware glue: modules, GPU firmware from vendor_a, speaker DSP tuning, touch (iptsd), second panel
[Unit]
Description=Surface Duo hardware glue
After=systemd-udevd.service systemd-udev-trigger.service local-fs.target
# The desktop's haptics (our wvkbd, tools/linux/sxmo/wvkbd) opens the DA7280 that duo-hw loads; hfd-service (Plasma
# Mobile's haptics until 2026-11-13) picked its vibrator ONCE at start, hence the ordering. The 2026-11-08 freezes came
# from runtime rmmod/insmod of da7280 (an oops); with kernel 0089 (FF_RUMBLE) the motor is driven without errors.
Before=display-manager.service sddm.service hfd-service.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/duo/duo-hw start
ExecStop=/usr/libexec/duo/duo-hw stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
