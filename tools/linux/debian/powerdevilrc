# Surface Duo defaults (users can change them in Settings > Power): closing the phone turns the screens off.
# LidAction 64 = turn off screen; the second screen counts as an "external monitor", which must not inhibit it.
[AC][SuspendAndShutdown]
LidAction=64
InhibitLidActionWhenExternalMonitorPresent=false

[Battery][SuspendAndShutdown]
LidAction=64
InhibitLidActionWhenExternalMonitorPresent=false

[LowBattery][SuspendAndShutdown]
LidAction=64
InhibitLidActionWhenExternalMonitorPresent=false

