# Surface Duo: once per user, a status bar + navigation bar on the left screen too (duo-left-panels).
[Unit]
Description=Surface Duo: panels on the left screen (once)
After=plasma-plasmashell.service
ConditionPathExists=!%h/.local/state/duo-left-panels.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/duo/duo-left-panels

[Install]
WantedBy=plasma-workspace.target
